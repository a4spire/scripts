# Backend
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# Postgres (docker-compose service name "postgres" when run via Compose)
DATABASE_URL=postgresql://werkstatt:werkstatt@localhost:5432/werkstatt

# Session
SESSION_SECRET=change-me-to-a-long-random-string

# Anthropic API (never commit a real key)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Lokaler Whisper-ASR-Container (leer lassen = Sprachnotiz-Feature deaktiviert)
WHISPER_API_URL=http://whisper:9000

# Foto-Speicher (im Container gemountetes Volume)
PHOTO_STORAGE_DIR=/app/storage/photos

# Initialer Admin-User (nur beim ersten Seed relevant)
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=changeme123
